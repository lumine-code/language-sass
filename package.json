{
  "name": "language-sass",
  "author": "lumine-code",
  "version": "1.0.0",
  "main": "lib/main",
  "files": [
    "grammars",
    "lib",
    "settings",
    "snippets",
    "spec"
  ],
  "description": "Sass and SCSS language support.",
  "keywords": [
    "scss",
    "stylesheet",
    "css-preprocessor",
    "tree-sitter"
  ],
  "license": "MIT",
  "engines": {
    "lumine": "^1.0.0",
    "node": ">=24"
  },
  "repository": "https://github.com/lumine-code/language-sass",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.3.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6"
  },
  "consumedServices": {
    "hyperlink.injection": {
      "versions": {
        "^1.0.0": "consumeHyperlinkInjection"
      }
    },
    "todo.injection": {
      "versions": {
        "^1.0.0": "consumeTodoInjection"
      }
    }
  },
  "bugs": {
    "url": "https://github.com/lumine-code/language-sass/issues"
  },
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  }
}
