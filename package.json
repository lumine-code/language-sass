    "scss",
    "stylesheet",
    "css-preprocessor",
    "tree-sitter"
  ],
  "license": "MIT",
  "engines": {
    "lumine": "^1.0.0",
    "node": ">=24"
  },
  "repository": "https://github.com/lumine-code/language-sass",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  },
  "bugs": {
    "url": "https://github.com/lumine-code/language-sass/issues"
  },
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "specPackages": [
    "snippets",
    "language-hyperlink",
    "language-todo"
  ]
}
