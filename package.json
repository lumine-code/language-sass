{
  "name": "language-sass",
  "author": "lumine-code",
  "version": "1.0.0",
  "main": "lib/main",
  "files": [
    "grammars",
    "lib",
    "settings",
    "snippets",
    "spec",
    "THIRD_PARTY_NOTICES"
  ],
  "description": "Sass and SCSS language support.",
